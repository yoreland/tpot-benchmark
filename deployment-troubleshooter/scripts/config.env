# config.env - platform-specific defaults for the tpot deployment-troubleshooter skill.
#
# This file is sourced by every script (source ../config.env). Edit the values
# below to match the customer environment. Defaults reflect the current tpot
# GPU booking platform.
#
# READ-ONLY skill: nothing here or in the scripts performs a write operation.
#
# SECURITY: do NOT put the booking API Basic Auth password in this file.
# The scripts read it from the TPOT_API_AUTH environment variable instead:
#
#     export TPOT_API_AUTH='username:password'
#
# Likewise, AWS credentials come from the environment (AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN) and are never stored here.

# AWS region hosting the TpotBookingStack* CDK stacks.
export TPOT_REGION="${TPOT_REGION:-us-west-2}"

# Booking REST API base URL (served through CloudFront). GET for the list,
# GET /{bookingId} for a single booking.
export TPOT_API_BASE="${TPOT_API_BASE:-https://d2z5rc3gcx01u5.cloudfront.net/api/bookings}"

# DynamoDB tables.
export TPOT_BOOKING_TABLE="${TPOT_BOOKING_TABLE:-TpotBookingTable}"
export TPOT_PLAN_TABLE="${TPOT_PLAN_TABLE:-TpotDeploymentPlanTable}"

# Deployer Lambda + CloudWatch log group.
export TPOT_DEPLOYER_LAMBDA="${TPOT_DEPLOYER_LAMBDA:-tpot-booking-deployer}"
export TPOT_DEPLOYER_LOG_GROUP="${TPOT_DEPLOYER_LOG_GROUP:-/aws/lambda/tpot-booking-deployer}"

# S3 bucket that holds the compose files. The account id is account-specific;
# override this to the customer's real bucket name, e.g.
#   tpot-booking-compose-123456789012-us-west-2
export TPOT_COMPOSE_BUCKET="${TPOT_COMPOSE_BUCKET:-tpot-booking-compose-<acct>-us-west-2}"

# On-instance paths (read-only targets).
export TPOT_DEPLOY_LOG="${TPOT_DEPLOY_LOG:-/var/log/tpot-bench/deploy.log}"
export TPOT_SCRIPTS_DIR="${TPOT_SCRIPTS_DIR:-/opt/tpot-bench/scripts}"
export TPOT_MODELS_DIR="${TPOT_MODELS_DIR:-/opt/dlami/nvme/models}"

# Environment variable NAME that holds the booking API Basic Auth (user:pass).
# The value itself lives in the environment, never in this file.
export TPOT_API_AUTH_ENV="${TPOT_API_AUTH_ENV:-TPOT_API_AUTH}"
