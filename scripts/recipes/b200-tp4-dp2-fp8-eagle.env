# =============================================================================
# recipe: B200 x8 / FP8 checkpoint / tp=4 dp=2 dp-attention / EAGLE
# 用法:
#   CONFIRM_SPEND=yes bash scripts/launch-bench-ec2.sh --stage full \
#     --region ap-south-1 --az ap-south-1c --instance-type p6-b200.48xlarge \
#     --max-price 60.00 --recipe scripts/recipes/b200-tp4-dp2-fp8-eagle.env
#
# 上游依据:
#   1) README 第 6 节 preflight: FP4 原始 checkpoint 在 v0.5.12.post1 的 triton
#      fused MoE 上有 "Hidden size mismatch" assertion failure (B200 验证两次)
#   2) README 第 5.4 节: "换成预打包的 FP8 checkpoint sgl-project/DeepSeek-V4-Flash-FP8
#      (55 文件 / 294.1 GB / 273.9 GiB) —— 可用 DP-attention + DeepEP"
#   3) awslabs/awsome-distributed-ai dsv4flash-b300-intra-3p1d:
#        --tp 2 --dp 2 --enable-dp-attention --moe-a2a-backend megamoe
#        但 megamoe 需要 DeepGEMM（B300 专属），B200 应该也支持但可能有兼容性问题
#        先试 --moe-a2a-backend none (安全) 让 auto 路径选择
#   4) SGLang cookbook: "FP8 path — can use DP-attention + DeepEP"
#   5) LMSYS Day-0 博客: EAGLE 3/1/4 在 V4-Flash 上 accept_length ~2.5
#
# B200 180GB/卡 x 8 = 1440GB 总显存，294GB FP8 权重 + KV cache 绰绰有余
# =============================================================================

# --- 镜像 ---
export SGLANG_IMAGE="lmsysorg/sglang:v0.5.12.post1-cu130"

# --- 模型：FP8 pre-packed checkpoint ---
export MODEL_NAME="sgl-project/DeepSeek-V4-Flash-FP8"
export CHECKPOINT_GB=294

# --- 张量并行 + 数据并行 ---
export TP_SIZE=4

# --- 显存 ---
export MEM_FRACTION_STATIC=0.85

# --- 启动参数 ---
# tp=4 dp=2 enable-dp-attention + EAGLE
# 不指定 moe-a2a-backend 让 auto 路径选择（避免显式 megamoe 带来的兼容风险）
export SGLANG_EXTRA_ARGS="--trust-remote-code --dp 2 --enable-dp-attention --cuda-graph-max-bs 64 --speculative-algorithm EAGLE --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4"

# --- 环境变量 ---
export SGLANG_ENV_VARS="SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK=8320"

# --- benchmark 参数 ---
export BENCH_CUSTOM_INPUT=40000
export BENCH_CUSTOM_OUTPUT=1500
export BENCH_CUSTOM_PROMPTS=50
export BENCH_CUSTOM_CONCURRENCY=1
export BENCH_OFFICIAL_INPUT=30000
export BENCH_OFFICIAL_OUTPUT=4096
export BENCH_OFFICIAL_PROMPTS=50
export BENCH_OFFICIAL_CONCURRENCY=1
