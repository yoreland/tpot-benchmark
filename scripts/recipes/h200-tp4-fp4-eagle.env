# =============================================================================
# recipe A: H200 x4 / 原始 FP4 checkpoint / EAGLE 低延迟档
# 用法:
#   scripts/run-staged.sh --stage full --recipe scripts/recipes/h200-tp4-fp4-eagle.env
#   scripts/launch-bench-ec2.sh --stage full --recipe scripts/recipes/h200-tp4-fp4-eagle.env
#
# 本文件被 launch-bench-ec2.sh 原样追加到 user-data 的环境前言之后，
# 因此必须是合法 bash（只写 export VAR=value），并且可以覆盖前言里的任何变量。
#
# -----------------------------------------------------------------------------
# 上游依据（README 第 10 节把 SGLang cookbook 定为上游权威）
#   https://lmsysorg.mintlify.app/cookbook/autoregressive/DeepSeek/DeepSeek-V4
#   1) 变体表: DeepSeek-V4-Flash 单机可服务 B200/B300/GB200/GB300/H200 (TP=4)，
#      所以 H200 的张量并行度是 4，不是 8。
#   2) Hopper 注记原文: "Original FP4 checkpoints — apply the W4A16 MoE kernels
#      (Marlin) as the command generator picks for Hopper cells ... It is
#      TP-only" —— 这条路只能 TP，不能开 DP-attention，也没有 DeepEP。
#   3) 推测解码: 原始 Flash 用 EAGLE，low-latency 档 steps=3 / draft-tokens=4；
#      完整拼写在 cookbook 的 AMD 小节里给全了:
#        --speculative-algorithm EAGLE --speculative-num-steps 3
#        --speculative-eagle-topk 1 --speculative-num-draft-tokens 4
#      注意是 --speculative-algorithm，不是 --speculative-algo。
#   4) 冷启动: 首次 10-15 分钟（FlashInfer autotune + draft/verify 图捕获），
#      之后复用缓存，所以 SERVER_READY_TIMEOUT 不能低于这个量级。
#
# checkpoint 精确体积（磁盘护栏的依据；FEAT-001 用 HuggingFace API 实测）
#   deepseek-ai/DeepSeek-V4-Flash = 73 个文件 / 159630041626 字节
#     = 159.6 GB(十进制) / 148.7 GiB(二进制)
#   config.json: expert_dtype=fp4, quantization_config.quant_method=fp8,
#                num_nextn_predict_layers=1
#   MTP/draft 头随权重一起发布，所以不需要 --speculative-draft-model-path。
# -----------------------------------------------------------------------------
# 为什么这个 recipe 排第一: 它是唯一一个「权重最小(159.6 GB) + 官方 instruct
# checkpoint + cookbook 明确写了 Hopper 可跑」的组合，失败面最小。
# =============================================================================

export MODEL_NAME='deepseek-ai/DeepSeek-V4-Flash'
export CHECKPOINT_GB=160
export STORAGE_MARGIN_GB=80
export TP_SIZE=4
export MEM_FRACTION_STATIC=0.85

# cookbook: 单一镜像 lmsysorg/sglang:latest 覆盖 B200/B300/GB200/GB300/H100/H200，
# 当前对应 SGLang v0.5.16。不要退回 run-benchmark.sh 里的 v0.5.12.post1-cu130：
# README 9.1 记录过 v0.5.12 的 flashinfer 在老架构上直接 KeyError。
export SGLANG_IMAGE='lmsysorg/sglang:latest'

# cookbook 的命令面板用 `sglang serve`。这里默认沿用 `python3 -m
# sglang.launch_server`（新旧镜像都在，失败面更小）；想跟 cookbook 完全一致就把
# 下面第二行取消注释、第一行注释掉，并先用 --stage gpu-smoke 花约 $0.3 验证。
export SGLANG_LAUNCH_CMD='python3 -m sglang.launch_server'
# export SGLANG_LAUNCH_CMD='sglang serve'

# EAGLE low-latency 档 + Hopper 的 W4A16 Marlin MoE runner。
# --moe-runner-backend 的取值表（上游 server_arguments 文档）含 marlin；
# --fp4-gemm-backend 的 auto 在 SM80-SM90 上本来就会选 marlin，所以这里只显式
# 指定 MoE runner，不再重复指定 GEMM backend，避免两处互相打架。
# 刻意不写 --dp-size / --enable-dp-attention: Hopper FP4/Marlin 路径不支持。
export SGLANG_EXTRA_ARGS='--speculative-algorithm EAGLE --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --moe-runner-backend marlin --enable-metrics'

# 首次冷启动 10-15 分钟，2400s 留足余量（与 run-benchmark.sh 的
# POD_READY_TIMEOUT 一致）
export SERVER_READY_TIMEOUT=2400

# 权重镜像: 填上就走同 Region S3 同步，重试不再从 HuggingFace 拉 159.6 GB。
# 先用 scripts/mirror-checkpoint.sh 建镜像，再取消注释。
# export CHECKPOINT_S3_URI='s3://tpot-bench-results-077090643075-us-east-2/checkpoints/deepseek-ai__DeepSeek-V4-Flash/'
