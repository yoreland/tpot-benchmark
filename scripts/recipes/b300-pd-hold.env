# =============================================================================
# recipe: B300 x8 / "HOLD" mode for PD disaggregation testing
#
# Purpose:
#   Launch a B300 spot instance, download DeepSeek-V4-Flash model weights to
#   local NVMe, then KEEP THE INSTANCE ALIVE without running any benchmark
#   or starting any SGLang server.
#
#   After bootstrap completes (weights downloaded, SELF_TERMINATE=false skips
#   shutdown), the operator SSMs into the instance and manually deploys the
#   PD 3P1D docker-compose stack:
#     docker-compose-pd-v4flash-b300.yaml
#
# Why hold mode:
#   The PD 3P1D disaggregation setup (3 prefill + 1 decode + nginx router)
#   requires manual docker-compose deployment with per-container GPU pinning
#   and separate health checks. The poller's single-container launch path
#   cannot express this topology, so we use hold mode to get the weights
#   cached and the instance reserved, then deploy manually.
#
# What this recipe does NOT do:
#   - Does NOT start SGLang (the compose file handles that)
#   - Does NOT run any benchmark
#   - Does NOT self-terminate the instance
#
# Image: matches the PD docker-compose (v0.5.17-cu130, proven on B300)
# =============================================================================

export SGLANG_IMAGE="lmsysorg/sglang:v0.5.17-cu130"
export MODEL_NAME="deepseek-ai/DeepSeek-V4-Flash"
export CHECKPOINT_GB=160

# Hold mode: do not terminate after bootstrap
export SELF_TERMINATE=false

# TP size for weight download layout (8 GPUs available, but actual serving
# topology is defined in docker-compose, not here)
export TP_SIZE=2
export MEM_FRACTION_STATIC=0.85

# Minimal SGLANG_EXTRA_ARGS: only --trust-remote-code is needed for the model
# download path. The actual serving args are in docker-compose-pd-v4flash-b300.yaml.
export SGLANG_EXTRA_ARGS="--trust-remote-code"

# Environment variable required by DeepGEMM mega-MOE on v0.5.17
export SGLANG_ENV_VARS="SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK=16384"

# No benchmark parameters - this is a hold-only recipe
# (BENCH_* vars intentionally omitted)
