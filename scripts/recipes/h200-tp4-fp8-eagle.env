# =============================================================================
# recipe B: H200 x4 / 重打包 FP8 checkpoint / EAGLE 低延迟档 + DP-attention
# 用法:
#   scripts/run-staged.sh --stage full --recipe scripts/recipes/h200-tp4-fp8-eagle.env
#
# 本文件被 launch-bench-ec2.sh 原样追加到 user-data 的环境前言之后，
# 因此必须是合法 bash（只写 export VAR=value）。
#
# -----------------------------------------------------------------------------
# 上游依据
#   https://lmsysorg.mintlify.app/cookbook/autoregressive/DeepSeek/DeepSeek-V4
#   Hopper 注记原文: "Converted FP8 checkpoints (H100 and H200 only) —
#   pre-repackaged FP8 weights at sgl-project/DeepSeek-V4-Flash-FP8 and
#   sgl-project/DeepSeek-V4-Pro-FP8 unlock DP-attention + DeepEP and richer
#   parallelism"。这是 Hopper 上的第二条（也是最后一条）路。
#   推测解码仍用原始 Flash 的 EAGLE low-latency 档 steps=3 / topk=1 /
#   draft-tokens=4。
#
# checkpoint 精确体积（磁盘护栏的依据；规划期用 HuggingFace API 实测）
#   sgl-project/DeepSeek-V4-Flash-FP8 = 55 个文件 / 294055065805 字节
#     = 294.1 GB(十进制) / 273.9 GiB(二进制)（本次实现时用 HF API 实测）
#   这就是 README 5.4 原先写的「284 GB FP8」真正对应的东西，而它绝无可能塞进
#   上一次那块 200 GB 根盘 —— 这个 recipe 只有在 30.4 TB 本地 NVMe 真的挂上
#   之后才成立。
# -----------------------------------------------------------------------------
# 为什么排第二: 权重几乎翻倍（294.1 GB，下载和镜像都更贵），但换来 DP-attention
# 这条 FP4 路径拿不到的并行度。先跑 recipe A 拿到基线，再用它对比。
# =============================================================================

export MODEL_NAME='sgl-project/DeepSeek-V4-Flash-FP8'
export CHECKPOINT_GB=295
export STORAGE_MARGIN_GB=120
export TP_SIZE=4
export MEM_FRACTION_STATIC=0.85

export SGLANG_IMAGE='lmsysorg/sglang:latest'
export SGLANG_LAUNCH_CMD='python3 -m sglang.launch_server'
# export SGLANG_LAUNCH_CMD='sglang serve'

# EAGLE low-latency 档 + DP-attention。
# 上游 server_arguments 文档对 --enable-dp-attention 的说明是「The dp size
# should be equal to the tp size」，所以这里 --dp-size 取 4 = TP_SIZE。
# 文档里 data parallel 的正式拼写是 --data-parallel-size / --dp-size；
# run-benchmark.sh 用的 `--dp` 只是靠 argparse 前缀匹配才生效，这里不用它。
export SGLANG_EXTRA_ARGS='--speculative-algorithm EAGLE --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --dp-size 4 --enable-dp-attention --enable-metrics'

# --- 下面两块是「下一次迭代」的开关，默认关闭，理由写在各自注释里 ---
#
# (1) DeepEP: cookbook 说 FP8 重打包权重解锁 DP-attention + DeepEP，但它同时给了
#     一条硬约束: max-running-requests x MTP_draft_tokens <=
#     SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK，违反会在稳态负载下把
#     DeepEP 的 dispatch buffer 打爆（deep_ep.cpp:1105）。我们的验收负载是
#     max-concurrency 1，约束很容易满足，但这个 env 的合适取值没有实测依据，
#     所以默认不开。要开就把下面一行放出来，并且先跑一次 gpu-smoke。
#     注意 SGLANG_DEEPEP_NUM_MAX_DISPATCH_TOKENS_PER_RANK 是容器内的环境变量，
#     bench-bootstrap.sh 目前不透传任意 env 到 docker run，需要时得改那边的
#     docker run 参数，光在 recipe 里 export 是进不去容器的。
# export SGLANG_EXTRA_ARGS="$SGLANG_EXTRA_ARGS --moe-a2a-backend deepep --deepep-mode auto --ep-size 4 --max-running-requests 8"
#
# (2) SM90 全 FP8 MegaMoE（cookbook 标注 Experimental）: 需要带 SM90 FP8
#     MegaMoE 支持的 sgl-deep-gemm 构建，并且要保持 SGLANG_DSV4_FP4_EXPERTS=0。
#     它面向长上下文/大 batch 吞吐，而我们的验收目标是单并发低延迟，收益方向
#     不一致，所以默认不开。
# export SGLANG_EXTRA_ARGS="$SGLANG_EXTRA_ARGS --moe-a2a-backend megamoe"

export SERVER_READY_TIMEOUT=2400

# 294.1 GB 从 HuggingFace 拉一次很贵，这个 recipe 尤其应该先建 S3 镜像。
# export CHECKPOINT_S3_URI='s3://tpot-bench-results-077090643075-us-east-2/checkpoints/sgl-project__DeepSeek-V4-Flash-FP8/'
