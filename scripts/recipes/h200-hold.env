# =============================================================================
# recipe: H200 x8 (p5en.48xlarge) / "HOLD" 模式
#
# 用途：抢到 H200 后只把权重就位，不跑 benchmark、不起服务、不自终止。
#       之后由操作者用 docker-compose 手工部署：
#         scripts/docker-compose-tp8-h200.yaml  （整机 tp=8）
#         scripts/docker-compose-tp4-h200.yaml  （回退，cookbook 处方 tp=4）
#
# 为什么 hold：整机/PD 等多种拓扑要靠 compose 表达，poller 的单容器启动路径
#              表达不了，所以先把机器和权重锁住，再手工部署。
#
# 权重来源：走同 Region S3 镜像（CHECKPOINT_S3_URI），不再从 HuggingFace 拉
#           149 GB。镜像是在 B300 那台实例回收前 aws s3 sync 上去的。
#
# Hopper 注意事项（不能照抄 B300 的参数）：
#   - MoE runner 用 marlin（W4A16），不是 megamoe(DeepGEMM，Blackwell 路径)
#   - 不需要 SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK
#   - Hopper FP4/Marlin 是 TP-only，不能开 dp-attention
#   实际 serve 参数在 compose 里，这里只保留权重下载所需的最小集合。
# =============================================================================

export SGLANG_IMAGE='lmsysorg/sglang:v0.5.17-cu130'
export MODEL_NAME='deepseek-ai/DeepSeek-V4-Flash'
export CHECKPOINT_GB=160
export STORAGE_MARGIN_GB=80

# 同 Region S3 权重镜像：把「从 HF 拉 149 GB」变成「内网 s3 sync」
export CHECKPOINT_S3_URI='s3://tpot-bench-results-077090643075-us-west-2/checkpoints/deepseek-ai__DeepSeek-V4-Flash/'

# hold 模式：bootstrap 跑完不终止实例
export SELF_TERMINATE=false

# 权重下载阶段用不到真正的 serve 参数（实际拓扑由 compose 决定）
export TP_SIZE=8
export MEM_FRACTION_STATIC=0.85
export SGLANG_EXTRA_ARGS='--trust-remote-code'

export SERVER_READY_TIMEOUT=2400

# 无 BENCH_* 变量：hold 模式不跑任何 benchmark
