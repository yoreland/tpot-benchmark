# =============================================================================
# recipe A-sweep: H200 x4 / 原始 FP4 checkpoint / EAGLE 低延迟档 + 并发扫描
#
# 与 h200-tp4-fp4-eagle.env 的服务端配置逐字相同，只多做两件事：
#   1) 把镜像从 :latest 钉到 :v0.5.17（见下方「为什么钉版本」）
#   2) 打开 SWEEP_SPEC，在同一个 server 进程上补跑并发扫描
#
# 用法（只应配 --stage full；gpu-smoke 上跑 8K/1500 没有意义）:
#   CONFIRM_SPEND=yes scripts/launch-bench-ec2.sh --stage full \
#     --recipe scripts/recipes/h200-tp4-fp4-eagle-sweep.env
#
# -----------------------------------------------------------------------------
# 为什么要有这个 recipe
#   reports/h200-tp4-eagle-20260809/ 只有 max_concurrency=1 的两条 bench，
#   没有并发扫描，所以 H200 无法和 B300 做吞吐-延迟 tradeoff 的对比
#   （reports/b300-tp8-eagle-20260809/README.md 第 9 节把这件事列为待办）。
#
# 为什么钉版本 v0.5.17 而不是继续用 :latest
#   B300 报告的一个硬伤：40K/30K 两条 bench 的 server_info.version = 0.5.17，
#   而 concurrency-sweep/*.json 的 = 0.5.12.post1 —— 两组数字来自两个不同版本的
#   server 进程，不能相互印证。这里必须避免同一个坑：
#     - 已发表的 H200 baseline 实测跑在 0.5.17 上（:latest 当时解析到它）
#     - 2026-08-10 查 Docker Hub: latest 与 v0.5.17 同为 2026-08-08T00:09 推送、
#       同为 14.2 GB；v0.5.18 尚不存在
#   所以钉 v0.5.17 = 「和已发表 baseline 同版本」且「不会随 latest 漂移」。
#
# 关于 CUDA graph 覆盖（B300/H200 口径差异的关键一条）
#   B300 那轮显式带了 --cuda-graph-max-bs 64。H200 这一侧不需要：上一轮 H200
#   实测日志里 cuda_graph_config 自动解析成 decode max_bs=512、捕获 bs 列表
#   [1,2,...,32,40,...,512]，c=16/c=32 本来就在 graph 覆盖范围内。刻意不加这个
#   flag，保持与已发表 H200 baseline 的服务端参数逐字一致。
# =============================================================================

export MODEL_NAME='deepseek-ai/DeepSeek-V4-Flash'
export CHECKPOINT_GB=160
export STORAGE_MARGIN_GB=80
export TP_SIZE=4
export MEM_FRACTION_STATIC=0.85

# 钉死版本，理由见文件头
export SGLANG_IMAGE='lmsysorg/sglang:v0.5.17'
export SGLANG_LAUNCH_CMD='python3 -m sglang.launch_server'

# 与 h200-tp4-fp4-eagle.env 逐字相同，一个字都不要改：
# 改了就不能和已发表的 H200 baseline 对比了
export SGLANG_EXTRA_ARGS='--speculative-algorithm EAGLE --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4 --moe-runner-backend marlin --enable-metrics'

export SERVER_READY_TIMEOUT=2400

# --- 并发扫描 ---
# 前 6 档 (1 2 4 8 16 32) 与 B300 逐字对齐: 8000/1500, 32 prompts，
# 这是唯一能和 reports/b300-tp8-eagle-20260809/concurrency-sweep/ 直接比的口径。
#
# 后 2 档 (16:128 32:128) 是刻意补的：B300 那轮所有档位都只用 32 prompts，
# 到 c=32 时 32 个请求刚好一波就发完，实测 duration 只有 9.99s、achieved
# concurrency 只到 19.95 —— 也就是说 c=32 那个点根本没有进入稳态，是个
# 「样本量不足」的数。加大到 128 prompts 才能拿到稳态下的高并发数字。
# 命名规则: 默认 prompts 的档位落 bench_c<N>.json（与 B300 同名，便于对照），
#           覆盖了 prompts 的档位落 bench_c<N>_p<P>.json。
export SWEEP_SPEC='1 2 4 8 16 32 16:128 32:128'
export SWEEP_INPUT_TOKENS=8000
export SWEEP_OUTPUT_TOKENS=1500
export SWEEP_NUM_PROMPTS=32

# 预算护栏。实测上一轮 H200: 权重 63s + 冷启动约 17 min + 两条 bench 约 9 min。
# 本轮多了约 14 min 的扫描，预计总时长约 45-50 min（约 $20-22 @ $26.66/hr）。
# 80 分钟是硬上限，到点看门狗强制同步并自终止，最坏约 $35。
export MAX_RUNTIME_MINUTES=80
