# =============================================================================
# recipe: B200 x8 / 原始 FP4 checkpoint / unified tp=8 / 无投机解码
# 目的: 排除 EAGLE cuda-graph capture 触发 triton MoE padding bug 的可能
#       先拿到一组 baseline 数字（无 EAGLE），再迭代加投机解码
#
# 已知失败:
#   - v0.5.12.post1-cu130 + FP4 + EAGLE -> Hidden size mismatch (CUDA graph)
#   - v0.5.12.post1-cu130 + FP8 + dp-attention -> Downcasting not allowed
#   - latest + FP4 + EAGLE -> Hidden size mismatch (同样的 triton MoE bug)
# 本次尝试:
#   - latest + FP4 + TP=8 + 无 EAGLE + 无 dp-attention
#   - 如果 triton MoE padding bug 只在 CUDA graph capture 时触发（EAGLE 特有路径），
#     那么去掉 EAGLE 可能绕过它
# =============================================================================

export SGLANG_IMAGE="lmsysorg/sglang:latest"
export MODEL_NAME="deepseek-ai/DeepSeek-V4-Flash"
export CHECKPOINT_GB=160
export TP_SIZE=8
export MEM_FRACTION_STATIC=0.85

# 无投机解码，最简启动
export SGLANG_EXTRA_ARGS="--trust-remote-code --cuda-graph-max-bs 64"

export SGLANG_ENV_VARS=""

export BENCH_CUSTOM_INPUT=40000
export BENCH_CUSTOM_OUTPUT=1500
export BENCH_CUSTOM_PROMPTS=50
export BENCH_CUSTOM_CONCURRENCY=1
export BENCH_OFFICIAL_INPUT=30000
export BENCH_OFFICIAL_OUTPUT=4096
export BENCH_OFFICIAL_PROMPTS=50
export BENCH_OFFICIAL_CONCURRENCY=1
