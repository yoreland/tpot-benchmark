# =============================================================================
# recipe: B300 x8 / FP4 checkpoint / tp=2 dp=2 dp-attention megamoe / 无 EAGLE
# 严格照搬 awslabs/awsome-distributed-ai (worktree-repo-reorg branch)
# dsv4flash-b300-intra-3p1d/dsv4flash-pd-deploy.yaml 的 verified 配置
#
# 区别: 那个样例是 3P1D 分离部署，我们用 unified（所有 8 卡一个引擎），
# 但模型参数/镜像/环境变量/backend 完全相同。
#
# 上游原文 (COMMON flags in dsv4flash-pd-deploy.yaml):
#   --trust-remote-code
#   --model-path deepseek-ai/DeepSeek-V4-Flash
#   --tp 2 --dp 2
#   --enable-dp-attention
#   --moe-a2a-backend megamoe
#   --mem-fraction-static 0.85
#   --cuda-graph-max-bs 64
#   --skip-server-warmup
#   --enable-metrics
#
# 上游环境变量:
#   SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK=8320
#
# 为什么不开 EAGLE:
#   上游 PD 样例没开投机解码。先拿 baseline，确认服务能起来，再加 EAGLE 迭代。
#
# 为什么 B300 而不是 B200:
#   B200 上 triton fused MoE 有 "Hidden size mismatch" 的 padding bug，
#   已验证 4 次（两种镜像 × 两种配置）。B300 走 megamoe (DeepGEMM) backend，
#   完全不同的代码路径，上游已验证可工作。
# =============================================================================

export SGLANG_IMAGE="lmsysorg/sglang:v0.5.12.post1-cu130"
export MODEL_NAME="deepseek-ai/DeepSeek-V4-Flash"
export CHECKPOINT_GB=160

# tp=2 dp=2 -> 4个进程，每个占2卡，总共8卡
# 但 unified 模式下 dp=2 意思是 2 个 data-parallel 副本各自 tp=2，
# 刚好覆盖 4 卡。8 卡的情况应该是 tp=2 dp=4 或 tp=4 dp=2。
# awslabs 3P1D 是 3+1=4 个引擎各 tp=2，unified 等价是 tp=2 dp=4。
export TP_SIZE=2
export MEM_FRACTION_STATIC=0.85

# unified 8卡 = tp=2 dp=4 (每个 dp 副本 2 卡)
export SGLANG_EXTRA_ARGS="--trust-remote-code --dp 4 --enable-dp-attention --moe-a2a-backend megamoe --cuda-graph-max-bs 64 --skip-server-warmup --enable-metrics"

export SGLANG_ENV_VARS="SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK=8320"

export BENCH_CUSTOM_INPUT=40000
export BENCH_CUSTOM_OUTPUT=1500
export BENCH_CUSTOM_PROMPTS=50
export BENCH_CUSTOM_CONCURRENCY=1
export BENCH_OFFICIAL_INPUT=30000
export BENCH_OFFICIAL_OUTPUT=4096
export BENCH_OFFICIAL_PROMPTS=50
export BENCH_OFFICIAL_CONCURRENCY=1
