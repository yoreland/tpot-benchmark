# =============================================================================
# recipe: B200 x8 / 原始 FP4 checkpoint / unified tp=8 / 低延迟档
# 用法:
#   CONFIRM_SPEND=yes bash scripts/launch-bench-ec2.sh --stage full \
#     --region ap-south-1 --az ap-south-1c --instance-type p6-b200.48xlarge \
#     --max-price 60.00 --recipe scripts/recipes/b200-tp8-fp4-unified.env
#
# 上游依据:
#   1) awslabs/awsome-distributed-ai (worktree-repo-reorg branch)
#      dsv4flash-b300-intra-3p1d/dsv4flash-pd-deploy.yaml:
#        image: lmsysorg/sglang:v0.5.12.post1-cu130
#        SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK=8320
#        --tp 2 --dp 2 --enable-dp-attention --moe-a2a-backend megamoe
#   2) SGLang DeepSeek-V4 Cookbook (README 第 10 节 上游权威):
#        B200/B300 单机可服务，支持 dp-attention + megamoe
#   3) README 第 12.3 节: B200 tp=4 + EAGLE 推测 3.5-4.5ms TPOT
#
# 注意: B200 支持原生 FP4，与 B300 使用相同的软件路径（megamoe + dp-attention）
# 但是当前 v0.5.12.post1 对 DeepSeek-V4-Flash 的 FP4 + megamoe 有兼容性问题
# (Hidden size mismatch in MoE layer)。
# 回退策略: 先不开 dp-attention/megamoe，使用纯 TP=8 路径 + EAGLE
# =============================================================================

# --- 镜像：使用 awslabs 验证过的版本 ---
export SGLANG_IMAGE="lmsysorg/sglang:v0.5.12.post1-cu130"

# --- 模型 ---
export MODEL_NAME="deepseek-ai/DeepSeek-V4-Flash"
export CHECKPOINT_GB=160

# --- 张量并行 ---
export TP_SIZE=8

# --- 显存 ---
export MEM_FRACTION_STATIC=0.85

# --- 启动参数: 纯 TP=8 + EAGLE 投机解码（低延迟档） ---
# 不开 dp-attention/megamoe 以规避 Hidden size mismatch
# EAGLE 配置参考 cookbook 和 LMSYS Day-0 博客:
#   --speculative-algorithm EAGLE --speculative-num-steps 3
#   --speculative-eagle-topk 1 --speculative-num-draft-tokens 4
export SGLANG_EXTRA_ARGS="--trust-remote-code --cuda-graph-max-bs 64 --speculative-algorithm EAGLE --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4"

# --- 环境变量（传入容器） ---
export SGLANG_ENV_VARS="SGLANG_OPT_DEEPGEMM_MEGA_MOE_NUM_MAX_TOKENS_PER_RANK=8320"

# --- benchmark 参数（覆盖默认值以匹配客户验收标准） ---
export BENCH_CUSTOM_INPUT=40000
export BENCH_CUSTOM_OUTPUT=1500
export BENCH_CUSTOM_PROMPTS=50
export BENCH_CUSTOM_CONCURRENCY=1
export BENCH_OFFICIAL_INPUT=30000
export BENCH_OFFICIAL_OUTPUT=4096
export BENCH_OFFICIAL_PROMPTS=50
export BENCH_OFFICIAL_CONCURRENCY=1
