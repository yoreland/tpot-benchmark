# =============================================================================
# recipe C: H200 x4 / Flash Official (0731) FP4 checkpoint / DSpark draft head
# 用法:
#   scripts/run-staged.sh --stage full --recipe scripts/recipes/h200-tp4-dspark-0731.env
#
# 本文件被 launch-bench-ec2.sh 原样追加到 user-data 的环境前言之后，
# 因此必须是合法 bash（只写 export VAR=value）。
#
# -----------------------------------------------------------------------------
# 上游依据
#   https://lmsysorg.mintlify.app/cookbook/autoregressive/DeepSeek/DeepSeek-V4
#   1) 变体表: DeepSeek-V4-Flash-0731 = "Flash Official (0731), with a bundled
#      DSpark draft head; verified on 8xB200, 4xGB300, and 4xH200"
#      —— 4xH200 是上游明确写了已验证的拓扑，所以它是 H200 的第二个可信选择。
#   2) 3.4 DSpark 小节原文: "enable DSpark with --speculative-algorithm DSPARK
#      and do not set a separate --speculative-draft-model-path ... this recipe
#      omits --speculative-num-steps, --speculative-eagle-topk, and
#      --speculative-num-draft-tokens. SGLang reads the DSpark shape from the
#      checkpoint."
#      => 本文件刻意不含上面那三个 flag，一个都没有。
#   3) 同小节: --speculative-dspark-block-size N 可选；省略时 SGLang 从
#      checkpoint 读，当前 0731 权重解析出 5 个提议 token，这就是已验证默认值。
#      所以这里不写它 —— 先跑默认，之后再用 Playground 的滑杆思路 1..5 扫。
#   4) 同小节: "DSpark currently requires CUDA, pp_size == 1, and DP Attention
#      disabled" => 绝不能和 --enable-dp-attention 一起用。
#   5) 同小节: 4xGB300 的已验证命令保持 --mem-fraction-static 0.90，理由是给
#      batch-256 的 verify 图留余量。H200(141 GB HBM) 比 GB300 显存小，这里保守
#      用 0.85，OOM 再往下调；如果想完全照抄上游就改成 0.90。
#   6) 这仍然是 FP4 experts 的 checkpoint，所以和 recipe A 一样走 Hopper 的
#      W4A16 Marlin MoE 路径，TP-only。
#
# checkpoint 精确体积（磁盘护栏的依据；规划期用 HuggingFace API 实测）
#   deepseek-ai/DeepSeek-V4-Flash-0731 = 74 个文件 / 166898661074 字节
#     = 166.9 GB(十进制) / 155.4 GiB(二进制)（本次实现时用 HF API 实测）
#   expert_dtype=fp4，DSpark draft 头打包在同一个 repo 里。
# -----------------------------------------------------------------------------
# 为什么排第三: 它换掉的是「推测解码算法」这一个变量，而 recipe A 换的是最少的
# 东西。A 失败在服务起不来时，C 是最有价值的下一发（DSpark 与 EAGLE 是两套
# 完全不同的 draft 路径）；A 失败在性能不达标时，C 也是首选。
# =============================================================================

export MODEL_NAME='deepseek-ai/DeepSeek-V4-Flash-0731'
export CHECKPOINT_GB=167
export STORAGE_MARGIN_GB=80
export TP_SIZE=4
export MEM_FRACTION_STATIC=0.85

# DSPARK 只在 cookbook（V4 的上游权威）里有记载，上游 server_arguments 那张
# --speculative-algorithm 取值表还只列到 EAGLE/EAGLE3/NEXTN/STANDALONE/NGRAM，
# 说明它比较新。因此必须用 latest 镜像，不要往回钉版本。
export SGLANG_IMAGE='lmsysorg/sglang:latest'
export SGLANG_LAUNCH_CMD='python3 -m sglang.launch_server'
# export SGLANG_LAUNCH_CMD='sglang serve'

# 只有 --speculative-algorithm DSPARK，没有 steps / eagle-topk / draft-tokens，
# 也没有 --speculative-draft-model-path，也没有 DP-attention。
export SGLANG_EXTRA_ARGS='--speculative-algorithm DSPARK --moe-runner-backend marlin --enable-metrics'

export SERVER_READY_TIMEOUT=2400

# export CHECKPOINT_S3_URI='s3://tpot-bench-results-077090643075-us-east-2/checkpoints/deepseek-ai__DeepSeek-V4-Flash-0731/'
